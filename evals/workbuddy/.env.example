# WorkBuddy × EDITH — environment template. Copy into the vendor checkout as
# `.env` (evals/workbuddy/scripts/setup.sh does this when .env is absent).
# PLACEHOLDERS ONLY — never commit real credentials.

# Backend for the EDITH harness in `model_connection: direct` jobs.
# host.docker.internal reaches the host from Docker Desktop task containers.
WB_EDITH_BACKEND_URL=http://host.docker.internal:11434/v1
# Ollama needs no key; keep a placeholder so key plumbing stays exercised.
WB_EDITH_BACKEND_KEY=ollama-no-key-required
