# Optional EDITH environment settings.
# Copy to a local, ignored environment file only if needed.
# Never commit real credentials.

# Override the OpenCode model launched by `edith code`.
EDITH_CODE_MODEL=lmstudio-local/qwen/qwen3-vl-4b

# Optional audit directory override.
EDITH_AUDIT_DIR=/Users/example/.edith/audit

# Optional search providers.
BRAVE_SEARCH_API_KEY=replace-with-key-if-used
EDITH_SEARXNG_URL=http://127.0.0.1:8080

# Optional Google OAuth client overrides.
# Prefer ~/.config/edith/google-oauth-client.json for local use.
EDITH_GOOGLE_CLIENT_ID=replace-with-client-id
EDITH_GOOGLE_CLIENT_SECRET=replace-with-client-secret

